# Copy to .env and fill in. Never commit .env.

# --- Logpoint (required) -----------------------------------------------------------------------
LOGPOINT_URL=https://logpoint.example.com
LOGPOINT_USERNAME=api-user
LOGPOINT_SECRET_KEY=change-me
# TLS: keep verification on. For a private CA, point to its bundle instead of disabling it.
LOGPOINT_VERIFY_SSL=true
# LOGPOINT_CA_BUNDLE=/etc/ssl/certs/logpoint-ca.pem
# LOGPOINT_TIMEOUT_SECONDS=30
# LOGPOINT_SEARCH_TIMEOUT_SECONDS=90
# LOGPOINT_MAX_ROWS=500

# Alert Rule API (optional; enables list_alert_rules / get_alert_rule)
# LOGPOINT_JWT_SECRET=change-me
# LOGPOINT_JWT_SUBJECT=logpoint-mcp
# LOGPOINT_JWT_SCOPE=alertrules:read
# Rules created by the server: repos they search, and who owns their incidents (default: the JWT subject)
# LOGPOINT_ALERT_RULE_REPOS=default,_logpoint
# LOGPOINT_ALERT_RULE_ASSIGNEE=

# --- MCP server --------------------------------------------------------------------------------
# Register tools that change incidents or reach outside the SIEM (Jira, email, Teams). Off by default.
MCP_ALLOW_WRITE_ACTIONS=false
# Alert rule changes (needs LOGPOINT_JWT_*; adds the alertrules:write scope). Off by default.
MCP_ALLOW_ALERT_RULE_WRITES=false
# Also allow permanent deletion of inactive rules (backed up first).
MCP_ALLOW_ALERT_RULE_DELETE=false
# managed: only rules this server created can change. all: any rule that isn't protected.
# MCP_ALERT_RULE_SCOPE=managed
# Rule ids or name globs that can never be changed or deleted
# MCP_ALERT_RULE_PROTECTED=*ransomware*,*edr tamper*
# MCP_ALERT_RULE_NAME_PREFIX=AI - 
# MCP_ALERT_RULE_MAX_CHANGES_PER_HOUR=10
# MCP_ALERT_RULE_MAX_DAILY_TRIGGERS=50
# MCP_ALERT_RULE_CONFIRM_TTL_SECONDS=900
# MCP_ALERT_RULE_BACKUP_DIR=/var/lib/logpoint-mcp/alert-rule-backups
# Addresses or @domains alert rule emails may go to (recipients of a copied rule's email are always allowed)
# MCP_ALERT_RULE_EMAIL_ALLOWED_RECIPIENTS=soc@example.com,@example.com
# HTTP transport: comma-separated bearer tokens (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# MCP_AUTH_TOKENS=
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# Host headers accepted behind a reverse proxy (DNS-rebinding protection)
# MCP_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:*
# MCP_COMMENT_PREFIX=[AI triage]
# MCP_LOG_LEVEL=INFO
# MCP_LOG_FORMAT=text

# --- Threat intel (optional) ---------------------------------------------------------------------
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
# MISP_URL=https://misp.example.com
# MISP_API_KEY=
# MISP_VERIFY_SSL=true

# --- Jira (optional; needs MCP_ALLOW_WRITE_ACTIONS=true) -----------------------------------------
# JIRA_URL=https://your-org.atlassian.net
# JIRA_EMAIL=soc-bot@example.com        # Jira Cloud. Leave unset to use JIRA_API_TOKEN as a Data Center PAT.
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=SOC
# JIRA_ISSUE_TYPE=Task
# JIRA_LABELS=logpoint,soc-triage

# --- Email (optional; needs MCP_ALLOW_WRITE_ACTIONS=true) ----------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# SMTP_FROM_ADDRESS=soc-bot@example.com
# SMTP_DEFAULT_RECIPIENTS=soc@example.com
# Required: addresses or @domains the server may email
# SMTP_ALLOWED_RECIPIENTS=@example.com

# --- Microsoft Teams (optional; needs MCP_ALLOW_WRITE_ACTIONS=true) ------------------------------
# In the channel: ... > Workflows > "Post to a channel when a webhook request is received".
# Copy the URL it gives you. Anyone with the URL can post, so treat it as a secret.
# TEAMS_WEBHOOK_URL=
# Optional second workflow: a timestamped start-of-run message that @mentions the channel.
# See "Teams notifications" in the README for how to build it.
# TEAMS_ANNOUNCE_WEBHOOK_URL=
# Optional: post alert rule cards (proposals and rule changes) to a separate channel.
# Create the same "Post to a channel when a webhook request is received" workflow in that channel.
# Without it, alert rule cards go to TEAMS_WEBHOOK_URL.
# TEAMS_ALERT_RULE_WEBHOOK_URL=
# TEAMS_TITLE_PREFIX=[AI triage]

# --- MITRE ATT&CK --------------------------------------------------------------------------------
# MITRE_CACHE_PATH=/var/cache/logpoint-mcp/enterprise-attack.json
# MITRE_CACHE_MAX_AGE_DAYS=30
# ATT&CK release Logpoint's alert rule tags are hashed from (change only if Logpoint upgrades its ATT&CK version)
# MITRE_LOGPOINT_ATTACK_URL=https://raw.githubusercontent.com/mitre/cti/ATT%26CK-v18.1/enterprise-attack/enterprise-attack.json
# MITRE_LOGPOINT_CACHE_PATH=/var/cache/logpoint-mcp/enterprise-attack-logpoint.json
