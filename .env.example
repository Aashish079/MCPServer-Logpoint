# Copy to .env and fill in. Never commit .env.

# --- Logpoint (required) -----------------------------------------------------------------------
LOGPOINT_URL=https://logpoint.example.com
LOGPOINT_USERNAME=api-user
LOGPOINT_SECRET_KEY=change-me
# TLS: keep verification on. For a private CA, point to its bundle instead of disabling it.
LOGPOINT_VERIFY_SSL=true
# LOGPOINT_CA_BUNDLE=/etc/ssl/certs/logpoint-ca.pem
# LOGPOINT_TIMEOUT_SECONDS=30
# LOGPOINT_SEARCH_TIMEOUT_SECONDS=90
# LOGPOINT_MAX_ROWS=500

# Alert Rule API (optional; enables list_alert_rules / get_alert_rule)
# LOGPOINT_JWT_SECRET=change-me
# LOGPOINT_JWT_SUBJECT=logpoint-mcp
# LOGPOINT_JWT_SCOPE=alertrules:read

# --- MCP server --------------------------------------------------------------------------------
# Register tools that change incidents or reach outside the SIEM (Jira, email). Off by default.
MCP_ALLOW_WRITE_ACTIONS=false
# HTTP transport: comma-separated bearer tokens (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# MCP_AUTH_TOKENS=
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# Host headers accepted behind a reverse proxy (DNS-rebinding protection)
# MCP_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:*
# MCP_COMMENT_PREFIX=[AI triage]
# MCP_LOG_LEVEL=INFO
# MCP_LOG_FORMAT=text

# --- Threat intel (optional) ---------------------------------------------------------------------
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
# MISP_URL=https://misp.example.com
# MISP_API_KEY=
# MISP_VERIFY_SSL=true

# --- Jira (optional; needs MCP_ALLOW_WRITE_ACTIONS=true) -----------------------------------------
# JIRA_URL=https://your-org.atlassian.net
# JIRA_EMAIL=soc-bot@example.com        # Jira Cloud. Leave unset to use JIRA_API_TOKEN as a Data Center PAT.
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=SOC
# JIRA_ISSUE_TYPE=Task
# JIRA_LABELS=logpoint,soc-triage

# --- Email (optional; needs MCP_ALLOW_WRITE_ACTIONS=true) ----------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# SMTP_FROM_ADDRESS=soc-bot@example.com
# SMTP_DEFAULT_RECIPIENTS=soc@example.com
# Required: addresses or @domains the server may email
# SMTP_ALLOWED_RECIPIENTS=@example.com

# --- MITRE ATT&CK --------------------------------------------------------------------------------
# MITRE_CACHE_PATH=/var/cache/logpoint-mcp/enterprise-attack.json
# MITRE_CACHE_MAX_AGE_DAYS=30
